IMAGE=proofops-r108-public:p2
CADDY_IMAGE=caddy:2.10.2-alpine
API_HOST=REPLACE_STATIC_IP.sslip.io
ACME_EMAIL=REPLACE_OPERATOR_EMAIL
LOCAL_PORT=8000
# Existing worker ceilings; restart/recreate required after operator changes.
WORKER_CPUS=1.5
WORKER_MEMORY=2560m
OCR_PROCESSES=2
PDFIUM_WORKERS=4
# c8g.2xlarge (8 vCPU/16 GiB) candidate, active_runs=1:
# WORKER_CPUS=6
# WORKER_MEMORY=10g
# OCR_PROCESSES=2 (try 4 only after >=10% wall improvement, no OOM)
# PDFIUM_WORKERS=4
