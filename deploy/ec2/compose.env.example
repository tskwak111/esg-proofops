IMAGE=proofops-r108-public:p2
CADDY_IMAGE=caddy:2.10.2-alpine
API_HOST=REPLACE_STATIC_IP.sslip.io
ACME_EMAIL=REPLACE_OPERATOR_EMAIL
LOCAL_PORT=8000
# deploy.sh defaults; override with environment or --worker-cpus/--worker-memory.
WORKER_CPUS=6.0
WORKER_MEMORY=12g
OCR_PROCESSES=2
PDFIUM_WORKERS=4
# c8g.2xlarge (8 vCPU/16 GiB), active_runs=1:
# OCR_PROCESSES=2 (try 4 only after >=10% wall improvement, no OOM)
# PDFIUM_WORKERS=4
